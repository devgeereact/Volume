      "sheet":  { "value": "0 0 0 1px rgba(255,255,255,0.03), 0 24px 48px -24px rgba(0,0,0,0.70)", "use": "Galley sheet and live panel" },
      "pop":    { "value": "0 0 0 1px rgba(255,255,255,0.05), 0 18px 40px -12px rgba(0,0,0,0.75)", "use": "Menus, popovers, toasts" },
      "modal":  { "value": "0 0 0 1px rgba(255,255,255,0.06), 0 40px 90px -20px rgba(0,0,0,0.85)", "use": "Modal and command menu" },
