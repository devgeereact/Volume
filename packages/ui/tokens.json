    "heading":  { "family": "book", "size": "22px", "line": "28px", "weight": 500, "tracking": "-0.005em", "use": "Panel headings, chapter titles, live panel title" },
    "subhead":  { "family": "ui",   "size": "16px", "line": "22px", "weight": 600, "tracking": "0", "use": "Card titles, section labels in the inspector" },
