  "font": {
    "book":    { "value": "'Literata', 'Iowan Old Style', Georgia, serif", "role": "Book text, titles, summaries, big figures, the live stream", "licence": "SIL OFL 1.1" },
    "ui":      { "value": "'Schibsted Grotesk', ui-sans-serif, system-ui, sans-serif", "role": "Interface: navigation, labels, buttons, tables", "licence": "SIL OFL 1.1" },
