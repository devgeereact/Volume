{
  "name": "@volume/core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Volume book model, manuscript parser and writer, house-style checker, KDP maths, theme types. Pure TypeScript; config readers in ./node.",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
