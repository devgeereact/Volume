</w:pPr>
<w:r>
<w:t xml:space="preserve">Exercise: Before You Start</w:t>
</w:r>
</w:p>
<w:p>
<w:pPr>
<w:pStyle w:val="FirstParagraph"/>
</w:pPr>
<w:sdt>
