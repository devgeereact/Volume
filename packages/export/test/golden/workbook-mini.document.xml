<w:r>
<w:t xml:space="preserve"> </w:t>
</w:r>
<w:r>
<w:t xml:space="preserve">Set a ten-minute timer on your phone</w:t>
</w:r>
</w:p>
<w:p>
<w:pPr>
<w:pStyle w:val="FirstParagraph"/>
</w:pPr>
<w:sdt>
<w:sdtPr>
<w14:checkbox>
<w14:checked w14:val="0"/>
<w14:checkedState w14:val="2612" w14:font="MS Gothic"/>
