</w:r>
<w:r>
<w:t xml:space="preserve">Choose one corner to reset first</w:t>
</w:r>
</w:p>
<w:p>
<w:pPr>
<w:pStyle w:val="FirstParagraph"/>
</w:pPr>
<w:sdt>
<w:sdtPr>
