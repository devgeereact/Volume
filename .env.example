# Volume settings. Names only: copy to .env (development) or ~/apps/volume/shared/.env (host, mode 600) and fill in.
# Never commit a filled-in copy. Blank lines such as KEY= count as unset, so the default applies.
# Full meaning of each key: apps/server/src/config/env.ts and docs/07-operations/DEPLOYMENT.md.

# --- Runtime ---
# production on the host; leave blank for development.
NODE_ENV=
# local (development only, no sign-in) or clerk. Default: local, or clerk in production.
AUTH_MODE=
# Optional: load settings from this file instead of .env in the app folder.
VOLUME_ENV_FILE=
# Optional: the app folder (the release root on the host). Found automatically.
VOLUME_ROOT=
HOST=127.0.0.1
PORT=5181
LOG_LEVEL=info

# --- Public hosting ---
# Public origin, for example https://volume.example.com. Required in production.
APP_ORIGIN=
# Host header values to answer, comma separated. Default: the APP_ORIGIN host.
ALLOWED_HOSTS=
# Extra web origins allowed to write (development default: http://127.0.0.1:5180,http://localhost:5180).
WEB_ORIGINS=
# Trust Passenger and Cloudflare proxy headers (CF-Connecting-IP). Default: on in production only.
TRUST_PROXY=
# Requests per minute per visitor IP.
RATE_LIMIT_MAX=
RATE_LIMIT_WRITE_MAX=
RATE_LIMIT_HEALTH_MAX=
# Built web app folder served by the server. Default: web/ in the release folder.
WEB_DIST_DIR=
MAX_JSON_BYTES=
MAX_UPLOAD_BYTES=

# --- Sign-in (Clerk) ---
# Public key. The web build reads it as VITE_CLERK_PUBLISHABLE_KEY (set when running npm run build:release).
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless token checks (one line with \n, or real newlines in quotes).
CLERK_JWT_KEY=
# Who may sign in: verified email addresses and/or Clerk user ids, comma separated. At least one is required.
OWNER_EMAILS=
CLERK_ALLOWED_USER_IDS=

# --- Database ---
# sqlite (development) or mysql (host).
DB_CLIENT=sqlite
SQLITE_PATH=
MYSQL_HOST=
MYSQL_PORT=3306
# Unix socket path; replaces host and port when set.
MYSQL_SOCKET=
MYSQL_DATABASE=
# Runtime user: SELECT, INSERT, UPDATE, DELETE.
MYSQL_USER=
MYSQL_PASSWORD=
# Migration user for the migrate command: adds CREATE, ALTER, INDEX, DROP, REFERENCES.
MYSQL_MIGRATE_USER=
MYSQL_MIGRATE_PASSWORD=
# off (default for localhost) or verify (default for a remote host).
MYSQL_SSL=
MYSQL_SSL_CA=
MYSQL_CONNECTION_LIMIT=
# Default true, except production (run the migrate command instead).
AUTO_MIGRATE=
JOBS_ENABLED=

# --- Files and export ---
# Backups folder (DATA_DIR/backups). Host: ~/apps/volume/shared/data
DATA_DIR=
# Host: ~/apps/volume/shared/browsers (chromium-headless-shell 1243).
PLAYWRIGHT_BROWSERS_PATH=
# Host: ~/apps/volume/shared/chromium-libs (libatspi.so.0, libatk-bridge-2.0.so.0).
CHROMIUM_LD_LIBRARY_PATH=
# volume (default) or mock.
EXPORT_PROVIDER=

# --- AI (server side only) ---
OPENROUTER_API_KEY=
# auto (default), openrouter or mock.
AI_PROVIDER=
RESOLVE_SOURCE_REDIRECTS=
MOCK_STREAM_DELAY_MS=
MOCK_FAIL_NEXT_WRITING=

# --- Development and tests only ---
VOLUME_LOAD_ENV=
VOLUME_WEB_PORT=
VOLUME_API_PORT=
MYSQL_TEST_URL=
LIVE_AI=
LIVE_AI_IMAGES=
VOLUME_API=
