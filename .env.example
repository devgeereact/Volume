# Copy to .env and fill in. Never commit .env. The server reads it; the web app never sees it.
OPENROUTER_API_KEY=
# Optional: names the app on OpenRouter
OPENROUTER_APP_URL=http://localhost:5180
OPENROUTER_APP_TITLE=Volume
PORT=5181
HOST=127.0.0.1
DATA_DIR=./data
# Live AI runs in tests are off unless set to 1, and stop at this budget in US dollars
LIVE_AI=0
LIVE_AI_BUDGET_USD=2

# Database. sqlite for local work and tests, mysql for your cPanel database (D-015).
DB_CLIENT=sqlite
SQLITE_PATH=./data/volume.db
# cPanel MySQL: enable Remote MySQL in cPanel and add this Mac's IP first.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Set to true if your host supports TLS for MySQL connections
MYSQL_SSL=false
