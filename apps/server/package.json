{
  "name": "@volume/server",
  "private": true,
  "version": "0.0.0",
  "description": "Volume local API server: Fastify, Kysely (SQLite or MySQL), job queue, SSE, blob store.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/seed/seed-cli.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@volume/ai": "*",
    "@volume/core": "*",
    "@volume/export": "*",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "mysql2": "^3.24.5",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
