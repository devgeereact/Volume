# === BEGIN Cloudflare-origin-lock (2026-08-28) ===
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:CF-RAY} ^$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ - [F,L]
</IfModule>
# === END Cloudflare-origin-lock ===

# Volume (volume.gakinz.com): the whole site is the Passenger Node.js app (apps/volume/current, app.cjs).
# The cPanel Node.js selector writes its own "CLOUDLINUX PASSENGER CONFIGURATION" block below this line.
# Keep the origin lock above it, and keep nothing else in this docroot.
Options -Indexes

# Do not name the web server or its version (audit, 1 November 2026). LiteSpeed adds X-Turbo-Charged-By; Cloudflare
# already replaces Server with "cloudflare". The app sends neither header itself.
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always unset X-Turbo-Charged-By
  Header unset X-Powered-By
  Header unset X-Turbo-Charged-By
</IfModule>
